set -euo pipefail


# -- Resolve the target user's home directory even if invoked with sudo.

USER_NAME="${SUDO_USER:-$USER}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
if [[ -z "$USER_HOME" || "$USER_HOME" == / ]]; then
    echo "Error: Could not resolve a safe target user home directory." >&2
    exit 1
fi


# MauiKit applications MUST be built with CMake and ECM.
# NEVER build MauiKit software using Meson; its QML module generation is incomplete.

export PATH="/usr/lib/qt6/bin:/usr/lib/qt6/libexec:$PATH"


# -- Directories to build in dependency order.

REPOS=(
    "$USER_HOME/Build/mauikit-demo"
    "$USER_HOME/GitHub/Nitrux/maui-buho"
    "$USER_HOME/GitHub/Nitrux/maui-clip"
    "$USER_HOME/GitHub/Nitrux/maui-fiery"
    "$USER_HOME/GitHub/Nitrux/maui-index"
    "$USER_HOME/GitHub/Nitrux/maui-nota"
    "$USER_HOME/GitHub/Nitrux/maui-pix"
    "$USER_HOME/GitHub/Nitrux/maui-settings"
    "$USER_HOME/GitHub/Nitrux/maui-shelf"
    "$USER_HOME/GitHub/Nitrux/maui-station"
    "$USER_HOME/GitHub/Nitrux/maui-vvave"
)


# -- Authenticate sudo upfront and keep the timestamp alive during the build.

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEP_ALIVE_PID=$!
trap 'kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true' EXIT

for dir in "${REPOS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "Error: Directory not found -> $dir" >&2
        exit 1
    fi
done

DEB_HOST_MULTIARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
INSTALL_PREFIX=/usr

cmake_args=(-DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX"
            -DKDE_INSTALL_LIBDIR="lib/$DEB_HOST_MULTIARCH"
            -DCMAKE_BUILD_TYPE=Release)
if [[ "$(dpkg-architecture -qDEB_HOST_ARCH)" == "amd64" ]]; then
    cmake_args+=(-DCMAKE_CXX_FLAGS=-march=x86-64-v3)
fi

for dir in "${REPOS[@]}"; do
    project_name="$(basename "$dir")"
    build_dir="$dir/build"

    echo "=================================================="
    echo "  Building: $project_name"
    echo "=================================================="

    sudo rm -rf -- "$build_dir"

    if [[ -f "$dir/CMakeLists.txt" ]]; then
        cmake -S "$dir" -B "$build_dir" "${cmake_args[@]}"
        cmake --build "$build_dir" --parallel "$(nproc)"
        sudo env --unset=DESTDIR cmake --install "$build_dir"
    else
        echo "Error: No supported build system found in $dir" >&2
        exit 1
    fi

    echo ""
done

echo "All Maui applications built and installed under $INSTALL_PREFIX"
