set -eu


# -- Resolve the target user's home directory even if invoked with sudo.

USER_NAME="${SUDO_USER:-$USER}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"


# MauiKit and every MauiKit component MUST be built with CMake and ECM.
# NEVER build this software using Meson; its QML module generation is incomplete.

export PATH="/usr/lib/qt6/bin:/usr/lib/qt6/libexec:$PATH"


# -- Directories to build in order.

REPOS=(
    "$USER_HOME/GitHub/Nitrux/maui-manager-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-accounts-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-audio-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-calendar-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-filebrowsing-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-archiver-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-documents-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-imagetools-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-texteditor-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-terminal-src"
    "$USER_HOME/GitHub/Nitrux/mauikit-system-src"
)


# -- Authenticate sudo upfront and keep the timestamp alive during the build.

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEP_ALIVE_PID=$!
trap 'kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true' EXIT

DEB_HOST_MULTIARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
INSTALL_PREFIX=/usr

cmake_args=(-DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX"
            -DKDE_INSTALL_LIBDIR="lib/$DEB_HOST_MULTIARCH"
            -DCMAKE_BUILD_TYPE=Release)
if [[ "$(dpkg-architecture -qDEB_HOST_ARCH)" == "amd64" ]]; then
    cmake_args+=(-DCMAKE_CXX_FLAGS=-march=x86-64-v3)
fi

for dir in "${REPOS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "Error: Directory not found -> $dir" >&2
        exit 1
    fi

    echo "=================================================="
    echo "  Building: $(basename "$dir")"
    echo "=================================================="

    sudo rm -rf "$dir/build"

    cmake -S "$dir" -B "$dir/build" "${cmake_args[@]}"
    cmake --build "$dir/build" --parallel "$(nproc)"
    sudo env --unset=DESTDIR cmake --install "$dir/build"

    if [[ "$(basename "$dir")" == "mauikit-src" ]]; then
        style_qmldir="/usr/lib/$DEB_HOST_MULTIARCH/qt6/qml/org/mauikit/style/qmldir"
        style_plugin="/usr/lib/$DEB_HOST_MULTIARCH/qt6/qml/org/mauikit/style/libMauiStyle.so"
        if [[ ! -f "$style_qmldir" || ! -f "$style_plugin" ]]; then
            echo "Error: MauiKit style QML module was not installed at $style_qmldir" >&2
            exit 1
        fi
    fi

    echo ""
done

echo "All components built and installed under $INSTALL_PREFIX"
