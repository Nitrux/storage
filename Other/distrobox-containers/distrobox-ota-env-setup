set -eu


# -- Environment variables.

export DEBIAN_FRONTEND=noninteractive


# -- Check if APT exists.

if ! command -v apt >/dev/null 2>&1; then
    echo "Error: 'apt' command not found. Please make sure it's available and try again, quitting."
    exit 1
fi


# -- Add APT configuration.
#   -- Remove source definitions inherited from the base image. Keeping them active can mix Debian stable packages with the testing snapshot below.

rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources

cp -r "$PWD"/container-setup/configs/files/apt_preferences/* /etc/apt/preferences.d/
cp -r "$PWD"/container-setup/configs/files/apt_conf/* /etc/apt/apt.conf.d/


# -- Source APT commands as functions.
# shellcheck source=/dev/null

source "$PWD"/container-setup/configs/scripts/others/apt-funcs


# -- Add Nitrux repository keys.

add_nitrux_key testing
add_nitrux_key area51
add_nitrux_key skidrow
add_nitrux_key mauikit
add_nitrux_key nvidia


# -- Add build sources.

cp "$PWD"/container-setup/configs/files/sources/{debian,nitrux-ota}.sources /etc/apt/sources.list.d/


# -- Install packages.

INSTALL_PKGS=(
    apt-file
    equivs
    pipx
    python3-gnupg
    mksquashfs
    zstd
)

install "${INSTALL_PKGS[@]}"


# -- Refresh package indexes after all diversions are registered.

update


# -- Align toolchain with the testing snapshot before the full upgrade.

DOWNGRADE_PKGS=(
    "libatomic1=16.2.0-3"
    "libgcc-s1=16.2.0-3"
    "libstdc++6=16.2.0-3"
    "gcc-16-base=16.2.0-3"
    "libexpat1=2.9.0-1"
    "libcom-err2=1.47.4-1+b2"
    "libharfbuzz0b=12.3.2-2+b2"
)

install_downgrades "${DOWNGRADE_PKGS[@]}"


# -- Upgrade rootfs packages as a coordinated dependency transition.
#   -- apt upgrade/--only-upgrade can unpack libraries without upgrading the packages that must match them (for example libsmartcols and util-linux).

dist_upgrade_brute_force
dpkg_conf


# -- Update apt-file index.

db_file_update


# -- Cleanup packages.

autoremove
