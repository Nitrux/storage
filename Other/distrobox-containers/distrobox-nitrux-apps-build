set -euo pipefail


# -- Resolve the target user's home directory even if invoked with sudo.

USER_NAME="${SUDO_USER:-$USER}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
if [[ -z "$USER_HOME" || "$USER_HOME" == / ]]; then
    echo "Error: Could not resolve a safe target user home directory." >&2
    exit 1
fi


# Nitrux MauiKit applications MUST be built with CMake and ECM; NEVER use Meson.
# -- Make Qt 6 development tools visible to CMake and ECM.

export PATH="/usr/lib/qt6/bin:/usr/lib/qt6/libexec:$PATH"


# -- Directories to build in dependency order.

REPOS=(
    "$USER_HOME/GitHub/Nitrux/appfinder"
    "$USER_HOME/GitHub/Nitrux/cinderward"
    "$USER_HOME/GitHub/Nitrux/desklock"
    "$USER_HOME/GitHub/Nitrux/marina"
    "$USER_HOME/GitHub/Nitrux/nudge-osd"
    "$USER_HOME/GitHub/Nitrux/nuts-cpp"
    "$USER_HOME/GitHub/Nitrux/polkit-nx-agent"
    "$USER_HOME/GitHub/Nitrux/qmlgreet"
    "$USER_HOME/GitHub/Nitrux/qmlogout"
    "$USER_HOME/GitHub/Nitrux/valenz"
    "$USER_HOME/GitHub/Nitrux/wirecloak"
    "$USER_HOME/GitHub/Nitrux/xdg-desktop-portal-nx"
)


# -- Authenticate sudo upfront and keep the timestamp alive during the build.

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEP_ALIVE_PID=$!
trap 'kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true' EXIT

for dir in "${REPOS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "Error: Directory not found -> $dir" >&2
        exit 1
    fi
done

INSTALL_PREFIX=/usr

cmake_args=(
    -DCMAKE_INSTALL_PREFIX="$INSTALL_PREFIX"
    -DCMAKE_BUILD_TYPE=Release
)
if [ "$(dpkg-architecture -qDEB_HOST_ARCH)" = "amd64" ]; then
    cmake_args+=(-DCMAKE_CXX_FLAGS=-march=x86-64-v3)
fi

for dir in "${REPOS[@]}"; do
    project_name="$(basename "$dir")"
    build_dir="$dir/build"

    echo "=================================================="
    echo "  Building: $project_name"
    echo "=================================================="

    project_cmake_args=("${cmake_args[@]}")
    case "$project_name" in
        marina|valenz|xdg-desktop-portal-nx)
            # These projects use GNUInstallDirs and do not consume KDE_INSTALL_LIBDIR.
            ;;
        *)
            project_cmake_args+=(
                -DKDE_INSTALL_LIBDIR="lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)")
            ;;
    esac

    sudo rm -rf -- "$build_dir"

    if [[ ! -f "$dir/CMakeLists.txt" ]]; then
        echo "Error: CMakeLists.txt not found in $dir" >&2
        exit 1
    fi

    cmake -S "$dir" -B "$build_dir" "${project_cmake_args[@]}"
    cmake --build "$build_dir" --parallel "$(nproc)"
    sudo env --unset=DESTDIR cmake --install "$build_dir"

    echo ""
done

echo "All Nitrux applications built and installed under $INSTALL_PREFIX"
