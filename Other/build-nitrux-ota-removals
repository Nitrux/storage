# -- Exit on errors.

set -euo pipefail

usage() {
	printf "%s\n" "Usage: $0 --var-db-old FILE --var-db-new FILE --removed-list FILE [--removed-list FILE ...] [--output-dir DIRECTORY]"
}

output_dir="$PWD"
var_db_old=""
var_db_new=""
removed_lists=()

while [ "$#" -gt 0 ]; do
	case "$1" in
		--var-db-old)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			[ -z "$var_db_old" ] || {
				printf "%s\n" "--var-db-old may only be specified once." >&2
				exit 2
			}
			var_db_old=$2
			shift 2
			;;
		--var-db-new)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			[ -z "$var_db_new" ] || {
				printf "%s\n" "--var-db-new may only be specified once." >&2
				exit 2
			}
			var_db_new=$2
			shift 2
			;;
		--removed-list)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			removed_lists+=("$2")
			shift 2
			;;
		--output-dir|-o)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			output_dir=$2
			shift 2
			;;
		--help|-h)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 2
			;;
	esac
done

[ -n "$var_db_old" ] || {
	printf "%s\n" "--var-db-old is required." >&2
	usage >&2
	exit 2
}

[ -f "$var_db_old" ] || {
	printf "Missing old dpkg database archive: %s\n" "$var_db_old" >&2
	exit 1
}

[ -n "$var_db_new" ] || {
	printf "%s\n" "--var-db-new is required." >&2
	usage >&2
	exit 2
}

[ -f "$var_db_new" ] || {
	printf "Missing new dpkg database archive: %s\n" "$var_db_new" >&2
	exit 1
}

[ "${#removed_lists[@]}" -gt 0 ] || {
	printf "%s\n" "At least one --removed-list is required." >&2
	usage >&2
	exit 2
}

for list in "${removed_lists[@]}"; do
	[ -f "$list" ] || {
		printf "Missing removal list: %s\n" "$list" >&2
		exit 1
	}
done

case "$output_dir" in
	/*) ;;
	*) output_dir="$PWD/$output_dir" ;;
esac

for command in awk cmp comm dpkg-deb sort tar; do
	command -v "$command" >/dev/null 2>&1 || {
		printf "Missing required command: %s\n" "$command" >&2
		exit 1
	}
done

declare -A removed_package_set=()
for list in "${removed_lists[@]}"; do
	while IFS= read -r package || [ -n "$package" ]; do
		[ -n "$package" ] || continue
		[[ "$package" =~ ^[a-z0-9][a-z0-9+.-]*(:[a-z0-9]+)?$ ]] || {
			printf "Invalid package name in %s: %s\n" "$list" "$package" >&2
			exit 1
		}
		removed_package_set["$package"]=1
	done < "$list"
done

[ "${#removed_package_set[@]}" -gt 0 ] || {
	printf "%s\n" "The removal lists contain no packages." >&2
	exit 1
}

mapfile -t removed_packages < <(printf "%s\n" "${!removed_package_set[@]}" | sort)

mkdir -p -- "$output_dir"

work_dir=$(mktemp -d)
trap 'rm -rf -- "$work_dir"' EXIT

package_root="$work_dir/package"
data_dir="$package_root/usr/share/nitrux-ota-removals"
old_info_dir="$work_dir/old-info"
new_info_dir="$work_dir/new-info"
mkdir -p -- "$package_root/DEBIAN" "$data_dir" "$old_info_dir" "$new_info_dir"

extract_package_lists() {
	archive=$1
	destination=$2
	description=$3
	if ! tar -xf "$archive" -C "$destination" \
		--wildcards '/var/lib/dpkg/info/*.list' \
		--transform='s#^/var/lib/dpkg/info/##'; then
		printf "Unable to extract package file lists from %s dpkg database archive: %s\n" "$description" "$archive" >&2
		exit 1
	fi
	set -- "$destination"/*.list
	[ -f "$1" ] || {
		printf "No package file lists found in %s dpkg database archive: %s\n" "$description" "$archive" >&2
		exit 1
	}
	if ! awk 'NF && $0 !~ /^\// { exit 1 }' "$destination"/*.list; then
		printf "A package file list in the %s dpkg database contains a non-absolute path: %s\n" "$description" "$archive" >&2
		exit 1
	fi
}

extract_package_lists "$var_db_old" "$old_info_dir" old
extract_package_lists "$var_db_new" "$new_info_dir" new

old_removed_paths="$work_dir/old-removed-paths"
new_owned_paths="$work_dir/new-owned-paths"
removal_manifest="$data_dir/paths-to-remove"
: > "$old_removed_paths"

for package in "${removed_packages[@]}"; do
	found_package_list=false
	candidate_lists=("$old_info_dir/$package.list")
	case "$package" in
		*:*) ;;
		*) candidate_lists+=("$old_info_dir/$package":*.list) ;;
	esac
	for source_list in "${candidate_lists[@]}"; do
		[ -f "$source_list" ] || continue
		found_package_list=true
		awk 'NF { print }' "$source_list" >> "$old_removed_paths"
	done
	[ "$found_package_list" = true ] || {
		printf "No package file list found in %s for removed package: %s\n" "$var_db_old" "$package" >&2
		exit 1
	}
done

LC_ALL=C sort -u -o "$old_removed_paths" "$old_removed_paths"
awk 'NF { print }' "$new_info_dir"/*.list | LC_ALL=C sort -u > "$new_owned_paths"
LC_ALL=C comm -23 "$old_removed_paths" "$new_owned_paths" > "$removal_manifest"

chmod 0644 "$removal_manifest"

postinst="$package_root/DEBIAN/postinst"
cat > "$postinst" <<'POSTINST'
#!/bin/sh

set -eu

[ "${1:-}" = configure ] || exit 0

removal_manifest=/usr/share/nitrux-ota-removals/paths-to-remove

if [ ! -f "$removal_manifest" ]; then
	printf "nitrux-ota-removals: missing removal manifest: %s\n" "$removal_manifest" >&2
	exit 1
fi
if [ ! -x /usr/bin/sort ]; then
	printf "%s\n" "nitrux-ota-removals: /usr/bin/sort is unavailable." >&2
	exit 1
fi

removed_files=0
while IFS= read -r path || [ -n "$path" ]; do
	case "$path" in
		/|/.) continue ;;
		/*) ;;
		*) continue ;;
	esac
	if { [ -e "$path" ] || [ -L "$path" ]; } && { [ ! -d "$path" ] || [ -L "$path" ]; }; then
		/bin/rm -f -- "$path"
		removed_files=$((removed_files + 1))
	fi
done < "$removal_manifest"

LC_ALL=C /usr/bin/sort -r -u "$removal_manifest" |
while IFS= read -r path || [ -n "$path" ]; do
	case "$path" in
		/|/.) continue ;;
		/*) ;;
		*) continue ;;
	esac
	[ -d "$path" ] && [ ! -L "$path" ] || continue
	/bin/rmdir -- "$path" 2>/dev/null || :
done

printf "nitrux-ota-removals: removed %s file(s).\n" "$removed_files"

exit 0
POSTINST
chmod 0755 "$postinst"

version="0.0.9-$(date +%Y%m%d%H%M%S)"
control="$package_root/DEBIAN/control"
printf "%s\n" \
	"Package: nitrux-ota-removals" \
	"Version: $version" \
	"Architecture: all" \
	"Maintainer: Uri Herrera <uri_herrera@nxos.org>" \
	"Section: oldlibs" \
	"Priority: optional" \
	"Multi-Arch: foreign" \
	"Homepage: https://nxos.org" \
	"Description: Remove files omitted from a Nitrux OTA target." \
	> "$control"
chmod 0644 "$control"

package_deb="$work_dir/nitrux-ota-removals_${version}_all.deb"
dpkg-deb --root-owner-group --build "$package_root" "$package_deb" >/dev/null
dpkg-deb --info "$package_deb" >/dev/null

audit_dir="$work_dir/audit"
mkdir -p -- "$audit_dir"
dpkg-deb --raw-extract "$package_deb" "$audit_dir"

[ -x "$audit_dir/DEBIAN/postinst" ] || {
	printf "%s\n" "Built package is missing an executable postinst." >&2
	exit 1
}

cmp -s "$postinst" "$audit_dir/DEBIAN/postinst" || {
	printf "%s\n" "Built package postinst differs from the generated script." >&2
	exit 1
}

[ -f "$audit_dir/DEBIAN/control" ] || {
	printf "%s\n" "Built package is missing its control file." >&2
	exit 1
}

cmp -s "$control" "$audit_dir/DEBIAN/control" || {
	printf "%s\n" "Built package control file differs from the generated metadata." >&2
	exit 1
}

for data_file in paths-to-remove; do
	[ -f "$audit_dir/usr/share/nitrux-ota-removals/$data_file" ] || {
		printf "Built package is missing embedded data file: %s\n" "$data_file" >&2
		exit 1
	}
	cmp -s "$data_dir/$data_file" "$audit_dir/usr/share/nitrux-ota-removals/$data_file" || {
		printf "Built package data file differs from its source: %s\n" "$data_file" >&2
		exit 1
	}
done

cp -- "$package_deb" "$output_dir/"
printf "Wrote %s with %s removal path(s).\n" \
	"$output_dir/$(basename "$package_deb")" \
	"$(awk 'END { print NR }' "$removal_manifest")" \
