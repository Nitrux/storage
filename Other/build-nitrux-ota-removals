# -- Exit on errors.

set -euo pipefail

usage() {
	printf "%s\n" "Usage: $0 --removed-list FILE [--removed-list FILE ...] [--output-dir DIRECTORY]"
}

output_dir="$PWD"
removed_lists=()

while [ "$#" -gt 0 ]; do
	case "$1" in
		--removed-list)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			removed_lists+=("$2")
			shift 2
			;;
		--output-dir|-o)
			[ "$#" -ge 2 ] || { usage >&2; exit 2; }
			output_dir=$2
			shift 2
			;;
		--help|-h)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 2
			;;
	esac
done

[ "${#removed_lists[@]}" -gt 0 ] || {
	printf "%s\n" "At least one --removed-list is required." >&2
	usage >&2
	exit 2
}

for list in "${removed_lists[@]}"; do
	[ -f "$list" ] || {
		printf "Missing removal list: %s\n" "$list" >&2
		exit 1
	}
done

case "$output_dir" in
	/*) ;;
	*) output_dir="$PWD/$output_dir" ;;
esac

for command in equivs-build dpkg-deb; do
	command -v "$command" >/dev/null 2>&1 || {
		printf "Missing required command: %s\n" "$command" >&2
		exit 1
	}
done

declare -A removed_package_set=()
for list in "${removed_lists[@]}"; do
	while IFS= read -r package || [ -n "$package" ]; do
		[ -n "$package" ] || continue
		[[ "$package" =~ ^[a-z0-9][a-z0-9+.-]*(:[a-z0-9]+)?$ ]] || {
			printf "Invalid package name in %s: %s\n" "$list" "$package" >&2
			exit 1
		}
		removed_package_set["$package"]=1
	done < "$list"
done

mapfile -t removed_packages < <(printf "%s\n" "${!removed_package_set[@]}" | sort)
[ "${#removed_packages[@]}" -gt 0 ] || {
	printf "%s\n" "The removal lists contain no packages." >&2
	exit 1
}

conflicts=$(printf "%s, " "${removed_packages[@]}")
conflicts=${conflicts%, }
postinst_packages=$(printf "%s " "${removed_packages[@]}")
postinst_packages=${postinst_packages% }

mkdir -p -- "$output_dir"

work_dir=$(mktemp -d)
trap 'rm -rf -- "$work_dir"' EXIT

version="0.0.1-$(date +%Y%m%d%H%M%S)"
removals_postinst="$work_dir/removals-postinst"
printf "%b\n" \
	"#!/bin/sh" \
	"" \
	"set -eu" \
	"" \
	"[ \"\${1:-}\" = configure ] || exit 0" \
	"" \
	"removed_packages=\"$postinst_packages\"" \
	"" \
	"for package in \$removed_packages; do" \
	"\tfor list_file in \"/var/lib/dpkg/info/\$package.list\" \"/var/lib/dpkg/info/\$package\":*.list; do" \
	"\t\t[ -f \"\$list_file\" ] || continue" \
	"" \
	"\t\tpackage_id=\${list_file#/var/lib/dpkg/info/}" \
	"\t\tpackage_id=\${package_id%.list}" \
	"" \
	"\t\twhile IFS= read -r path || [ -n \"\$path\" ]; do" \
	"\t\t\tcase \"\$path\" in" \
	"\t\t\t\t/*) ;;" \
	"\t\t\t\t*) continue ;;" \
	"\t\t\tesac" \
	"" \
	"\t\t\tif [ -f \"\$path\" ] || [ -L \"\$path\" ]; then" \
	"\t\t\t\towners=\$(/usr/bin/dpkg-query -S \"\$path\" 2>/dev/null || :)" \
	"\t\t\t\towned_by_other_package=false" \
	"\t\t\t\twhile IFS= read -r owner; do" \
	"\t\t\t\t\t[ -n \"\$owner\" ] || continue" \
	"\t\t\t\t\tcase \"\$owner\" in" \
	"\t\t\t\t\t\t\"\$package_id: \"*) ;;" \
	"\t\t\t\t\t\t*) owned_by_other_package=true; break ;;" \
	"\t\t\t\t\tesac" \
	"\t\t\t\tdone <<EOF" \
"\$owners" \
"EOF" \
"" \
	"\t\t\t\tif [ \"\$owned_by_other_package\" = false ]; then" \
	"\t\t\t\t\t/bin/rm -f -- \"\$path\"" \
	"\t\t\t\tfi" \
	"\t\t\tfi" \
	"\t\tdone < \"\$list_file\"" \
	"" \
	"\t\t/bin/rm -f -- \"/var/lib/dpkg/info/\$package_id\".*" \
	"\tdone" \
	"done" \
	"" \
	"exit 0" \
	> "$removals_postinst"
chmod 0755 "$removals_postinst"

control="$work_dir/removals-configuration"
printf "%s\n" \
	"Section: oldlibs" \
	"Priority: optional" \
	"Homepage: https://nxos.org" \
	"Package: nitrux-ota-removals" \
	"Version: $version" \
	"Maintainer: Uri Herrera <uri_herrera@nxos.org>" \
	"Conflicts: $conflicts" \
	"Replaces: $conflicts" \
	"Architecture: all" \
	"Postinst: $removals_postinst" \
	"Description: Remove packages omitted from a Nitrux OTA target." \
	> "$control"

(
	cd "$work_dir"
	equivs-build "$control"
)

package_deb=$(find "$work_dir" -maxdepth 1 -type f -name 'nitrux-ota-removals_*.deb' -print -quit)
[ -n "$package_deb" ] || {
	printf "%s\n" "Failed to build nitrux-ota-removals." >&2
	exit 1
}

dpkg-deb --info "$package_deb" >/dev/null
cp -- "$package_deb" "$output_dir/"
printf "Wrote %s\n" "$output_dir/$(basename "$package_deb")"
